#!/usr/bin/env bash
# Fixture tests for scripts/check-readme-map.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
check="$root/scripts/check-readme-map"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "test-check-readme-map: $1" >&2
  exit 1
}

chmod +x "$check"

"$check" "$root" >/dev/null || fail "live README should satisfy the map check"

fixture="$tmp/skills"
mkdir -p "$fixture/done" "$fixture/obsidian-skills/to-note"
printf '%s\n' '---' 'name: done' 'description: demo' '---' >"$fixture/done/SKILL.md"
printf '%s\n' '---' 'name: to-note' 'description: demo' '---' >"$fixture/obsidian-skills/to-note/SKILL.md"

cat >"$fixture/README.md" <<'MD'
- **done** — demo
- **gone** — demo

- **Skill directories**: 1
MD

if "$check" "$fixture" >/dev/null 2>"$tmp/bad.err"; then
  fail "incomplete README should fail"
fi
grep -q 'missing skill to-note' "$tmp/bad.err" || fail "should name the unlisted skill"
grep -q 'lists missing skill gone' "$tmp/bad.err" || fail "should name the listed but absent skill"
grep -q 'Skill directories' "$tmp/bad.err" || fail "should report directory count drift"
grep -q 'Unique names' "$tmp/bad.err" || fail "should require the unique-name count"

cat >"$fixture/README.md" <<'MD'
- **done** — demo
- **to-note** — demo

- **Skill directories**: 2
- **Unique names**: 2
MD

"$check" "$fixture" >/dev/null || fail "complete README fixture should pass"

mkdir -p "$fixture/.scratch/stray-skill"
printf '%s\n' '---' 'name: stray-skill' 'description: demo' '---' >"$fixture/.scratch/stray-skill/SKILL.md"
"$check" "$fixture" >/dev/null || fail "hidden scratch skills should be ignored"

echo "test-check-readme-map: ok"
