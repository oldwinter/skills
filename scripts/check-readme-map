#!/usr/bin/env python3
"""Verify the README skill list against the repo tree."""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path


def skill_dirs(repo: Path) -> list[Path]:
    """Skill directories under repo, ignoring hidden local-scratch trees."""
    dirs: list[Path] = []
    for dirpath, dirnames, filenames in os.walk(repo):
        dirnames[:] = [name for name in dirnames if not name.startswith(".")]
        if "SKILL.md" in filenames and Path(dirpath) != repo:
            dirs.append(Path(dirpath))
    return sorted(dirs)


def parse_stat(readme: str, label: str) -> int | None:
    match = re.search(rf"\*\*{re.escape(label)}\*\*:\s*(\d+)", readme)
    return int(match.group(1)) if match else None


def check(repo: Path) -> list[str]:
    readme_path = repo / "README.md"
    if not readme_path.is_file():
        return ["check-readme-map: missing README.md"]
    readme = readme_path.read_text(encoding="utf-8")
    listed = set(re.findall(r"^- \*\*([A-Za-z0-9._-]+)\*\*", readme, flags=re.MULTILINE))
    dirs = skill_dirs(repo)
    names = {path.name for path in dirs}
    errors = [f"check-readme-map: README missing skill {name}" for name in sorted(names - listed)]
    errors += [f"check-readme-map: README lists missing skill {name}" for name in sorted(listed - names)]
    for label, want in (("Skill directories", len(dirs)), ("Unique names", len(names))):
        got = parse_stat(readme, label)
        if got != want:
            errors.append(f"check-readme-map: README **{label}** is {got!r}, tree has {want}")
    return errors


def main() -> int:
    repo = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path(__file__).resolve().parents[1]
    errors = check(repo)
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("check-readme-map: README skill list matches the repo tree.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
