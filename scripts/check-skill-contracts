#!/usr/bin/env python3

import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
FAILURES: list[str] = []


def fail(message: str) -> None:
    FAILURES.append(message)




def check_frontmatter() -> None:
    for skill_file in sorted(ROOT.rglob("SKILL.md")):
        path = skill_file.relative_to(ROOT)
        content = skill_file.read_text(encoding="utf-8")
        if not content.startswith("---\n"):
            fail(f"missing frontmatter: {path}")
            continue
        end = content.find("\n---", 4)
        if end < 0:
            fail(f"unterminated frontmatter: {path}")
            continue
        block = content[4:end]
        name = re.search(r"^name:\s*['\"]?([^'\"\n]+)['\"]?\s*$", block, re.MULTILINE)
        if not name:
            fail(f"missing or multiline name: {path}")
        elif name.group(1) != skill_file.parent.name:
            fail(f"frontmatter name mismatch: {path}: {name.group(1)} != {skill_file.parent.name}")
        desc = re.search(r"^description:[ \t]*(.*)$", block, re.MULTILINE)
        if not desc or not desc.group(1).strip():
            fail(f"missing description: {path}")
            continue
        value = desc.group(1).strip()
        if value.split()[0] in (">", ">-", ">+", "|", "|-", "|+"):
            fail(f"block-scalar description: {path}")
        elif "<" in value or ">" in value:
            fail(f"angle bracket in description: {path}")






def check_personal_paths() -> None:
    pattern = re.compile(r"/Users/(oldwinter|alchain|affoon)(?:/|\b)")
    for path in sorted(ROOT.rglob("*")):
        if not path.is_file() or ".git" in path.parts:
            continue
        try:
            content = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if pattern.search(content):
            fail(f"personal machine path: {path.relative_to(ROOT)}")


def main() -> int:
    check_frontmatter()
    check_personal_paths()
    if FAILURES:
        for message in sorted(FAILURES):
            print(message, file=sys.stderr)
        return 1
    print("check-skill-contracts: audited skill contracts pass.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
