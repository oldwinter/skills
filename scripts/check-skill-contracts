#!/usr/bin/env python3
"""Audit SKILL.md contracts and repo-wide personal device paths.

Usage: check-skill-contracts [REPO]

REPO defaults to the repository root inferred from this script's location, so
fixture trees can be audited by passing an explicit path. Paths with a hidden
leading-dot component relative to REPO (`.git`, `.scratch`, ...) are local
scratch state rather than publishable repo content; they are pruned before the
scan instead of being walked. Inline Markdown links are checked; links inside
fenced code blocks are documentation examples, not live links.
"""

from __future__ import annotations

import os
import re
import sys
from collections.abc import Iterator
from pathlib import Path
from urllib.parse import unquote


NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
FENCE_RE = re.compile(r"^\s*(```|~~~)")
LINK_RE = re.compile(r"\[[^\]]*\]\(\s*([^)\s]+)(?:\s+[^)]*)?\)")
SCHEME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
DESCRIPTION_LIMIT = 1024
BLOCK_SCALARS = (">", ">-", ">+", "|", "|-", "|+")

# Personal home directories on macOS, Linux, and Windows. The general macOS
# form covers the owner account names the old check hardcoded. `~`, `$HOME`,
# and documented public runtime paths are portable notation, not device paths,
# so they stay allowed.
PERSONAL_PATH_RE = re.compile(
    r"/Users/[A-Za-z0-9._-]+(?:/|\b)"
    r"|/home/[A-Za-z0-9._-]+(?:/|\b)"
    r"|[A-Za-z]:[\\/]+Users[\\/]+[A-Za-z0-9._-]+"
)

FAILURES: list[str] = []


def fail(message: str) -> None:
    FAILURES.append(message)


def hidden(name: str) -> bool:
    return name.startswith(".")


def public_files(repo: Path) -> Iterator[Path]:
    """Files under repo with no hidden path component (local scratch pruned)."""
    for dirpath, dirnames, filenames in os.walk(repo):
        dirnames[:] = [name for name in dirnames if not hidden(name)]
        for filename in filenames:
            if not hidden(filename):
                yield Path(dirpath) / filename


def skill_files(repo: Path) -> Iterator[Path]:
    for path in public_files(repo):
        if path.name == "SKILL.md" and path.parent != repo:
            yield path


def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, OSError):
        return None


def prose(content: str) -> str:
    """Content minus fenced code blocks: example links are not real links."""
    lines: list[str] = []
    fenced = False
    for line in content.splitlines():
        if FENCE_RE.match(line):
            fenced = not fenced
            continue
        if not fenced:
            lines.append(line)
    return "\n".join(lines)


def relative_target(target: str) -> str | None:
    """Return the local path of a Markdown link target, or None to ignore it."""
    if not target or target.startswith("#"):
        return None
    if "<" in target or ">" in target:
        return None  # placeholder such as references/<name>.md
    if SCHEME_RE.match(target) or target.startswith("/"):
        return None  # absolute URL or absolute filesystem path
    local = target.split("#", 1)[0].split("?", 1)[0]
    return unquote(local) if local else None


def check_relative_links(skill_file: Path, rel: Path, content: str) -> None:
    for match in LINK_RE.finditer(prose(content)):
        target = relative_target(match.group(1))
        if target is None:
            continue
        if not (skill_file.parent / target).exists():
            fail(f"missing relative link: {rel}: {match.group(1)}")


def check_skill(skill_file: Path, rel: Path) -> None:
    content = skill_file.read_text(encoding="utf-8")
    if not content.startswith("---\n"):
        fail(f"missing frontmatter: {rel}")
        return
    end = content.find("\n---", 4)
    if end < 0:
        fail(f"unterminated frontmatter: {rel}")
        return
    block = content[4:end]
    name = re.search(r"^name:\s*['\"]?([^'\"\n]+)['\"]?\s*$", block, re.MULTILINE)
    if not name:
        fail(f"missing or multiline name: {rel}")
    else:
        value = name.group(1)
        if value != skill_file.parent.name:
            fail(f"frontmatter name mismatch: {rel}: {value} != {skill_file.parent.name}")
        if not NAME_RE.match(value):
            fail(f"invalid skill name: {rel}: {value}")
    desc = re.search(r"^description:[ \t]*(.*)$", block, re.MULTILINE)
    if not desc or not desc.group(1).strip():
        fail(f"missing description: {rel}")
        return
    raw = desc.group(1).strip()
    quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
    value = raw[1:-1] if quoted else raw
    if not value:
        fail(f"missing description: {rel}")
    elif value.split()[0] in BLOCK_SCALARS:
        fail(f"block-scalar description: {rel}")
    elif not quoted and ": " in value:
        # A plain YAML scalar cannot contain ": ": the value parses as a nested
        # mapping, and the skills CLI skips the whole skill without failing the
        # install, so it disappears silently. Quote the description instead.
        fail(f"unquoted description with ': ' (invalid YAML, skipped by installers): {rel}")
    elif "<" in value or ">" in value:
        fail(f"angle bracket in description: {rel}")
    elif len(value) > DESCRIPTION_LIMIT:
        fail(f"description too long: {rel}: {len(value)} > {DESCRIPTION_LIMIT} chars")
    check_relative_links(skill_file, rel, content)


def check_personal_paths(repo: Path) -> None:
    for path in public_files(repo):
        content = read_text(path)
        if content is not None and PERSONAL_PATH_RE.search(content):
            fail(f"personal machine path: {path.relative_to(repo)}")


def main() -> int:
    repo = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path(__file__).resolve().parents[1]
    for skill_file in skill_files(repo):
        check_skill(skill_file, skill_file.relative_to(repo))
    check_personal_paths(repo)
    if FAILURES:
        for message in sorted(FAILURES):
            print(message, file=sys.stderr)
        return 1
    print("check-skill-contracts: audited skill contracts pass.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
